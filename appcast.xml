<?xml version="1.0" standalone="yes"?>
<!--
  Luma appcast — used by Sparkle (Options A/B, currently dormant).
  To activate: uncomment startSparkleUpdater() in LumaApp.swift,
  generate a fresh EdDSA keypair, and add entries below per release.

  Per-release workflow (once GitHub Actions is set up):
    1. Build and notarize the .dmg
    2. Sign it:  .build/release/sign_update Luma.dmg <private_key>
    3. Prepend a new <item> block below with the output signature, URL, and size
    4. Commit appcast.xml to main — Sparkle polls this URL automatically

  Generate keys (one-time):
    .build/release/generate_keys
    → Public key  → Info.plist SUPublicEDKey
    → Private key → GitHub secret SPARKLE_PRIVATE_KEY (never commit)
-->
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" version="2.0">
    <channel>
        <title>Luma</title>

        <!-- ── v0.5.2 (Beta) ──────────────────────────────────────────────── -->
        <item>
            <title>Luma v0.5.2 (Beta)</title>
            <pubDate>Wed, 21 May 2026 00:00:00 -0700</pubDate>
            <sparkle:version>52</sparkle:version>
            <sparkle:shortVersionString>0.5.2</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:releaseNotesLink>https://github.com/nox-codes/Luma/releases/tag/v0.5.2</sparkle:releaseNotesLink>
            <!--
            Uncomment and fill in once Sparkle signing is set up:
            <enclosure
              url="https://github.com/nox-codes/Luma/releases/download/v0.5.2/Luma.dmg"
              length="REPLACE_WITH_BYTE_LENGTH"
              type="application/octet-stream"
              sparkle:edSignature="REPLACE_WITH_EDDSA_SIGNATURE"/>
            -->
        </item>

    </channel>
</rss>
